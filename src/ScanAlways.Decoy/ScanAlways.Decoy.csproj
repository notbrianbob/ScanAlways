<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ScanAlways.Decoy</RootNamespace>
    <!-- A plausible, scanner-like process name for the running decoy. -->
    <AssemblyName>ScanAlways.Protection.Service</AssemblyName>
    <Description>Always-scanning decoy host for the ScanAlways suite. Runs as a console app or Windows service.</Description>
    <UserSecretsId>scanalways-decoy</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScanAlways.Common\ScanAlways.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
