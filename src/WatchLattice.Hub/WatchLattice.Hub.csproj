<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WatchLattice.Hub</RootNamespace>
    <!-- A plausible, scanner-like process name for the resident hub (the decoy relies on it). -->
    <AssemblyName>WatchLattice.Protection.Service</AssemblyName>
    <Description>The WatchLattice hub: one process that runs every enabled tool as a module. Runs as a console app or Windows service.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WatchLattice.Common\WatchLattice.Common.csproj" />
    <ProjectReference Include="..\WatchLattice.Canary\WatchLattice.Canary.csproj" />
    <ProjectReference Include="..\WatchLattice.Decoy\WatchLattice.Decoy.csproj" />
    <ProjectReference Include="..\WatchLattice.DefenderWatchdog\WatchLattice.DefenderWatchdog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
