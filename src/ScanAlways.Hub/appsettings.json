{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Hub": {
    "RestartFailedModules": true,
    "RestartDelaySeconds": 30,
    "MaxRestartDelaySeconds": 600
  },
  "Modules": {
    "Decoy": { "Enabled": true },
    "Canary": { "Enabled": true },
    "DefenderWatchdog": { "Enabled": true },
    "Persistence": { "Enabled": true }
  },
  "Alerts": {
    "Enabled": true,
    "FeedPath": null,
    "HistoryLimit": 200
  },
  "Persistence": {
    "CheckIntervalSeconds": 300,
    "WatchRegistry": true,
    "WatchStartupFolders": true,
    "WatchScheduledTasks": true,
    "StartupFolders": [],
    "IgnoredEntries": [],
    "BaselinePath": null,
    "MaxStartupFileBytes": 4194304
  },
  "Decoy": {
    "Intensity": "Balanced",
    "ScanRoots": [],
    "MaxFilesPerSecond": 8,
    "BytesReadPerFile": 65536,
    "MaxFileSizeBytes": 268435456,
    "WriteScanLog": true,
    "ScanLogPath": null
  },
  "Canary": {
    "Folders": [],
    "FileNames": [],
    "MarkHidden": true,
    "CanarySizeBytes": 24576,
    "IntegrityCheckSeconds": 60,
    "AlertDebounceSeconds": 5,
    "RemoveCanariesOnStop": false,
    "AlertLogPath": null,
    "ManifestPath": null
  },
  "DefenderWatchdog": {
    "CheckIntervalSeconds": 300,
    "MaxSignatureAgeHours": 48,
    "CriticalSignatureAgeHours": 168,
    "TamperProtectionOffIsCritical": false,
    "AlertLogPath": null
  }
}
