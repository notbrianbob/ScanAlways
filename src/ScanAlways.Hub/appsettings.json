{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Hub": {
    "RestartFailedModules": true,
    "RestartDelaySeconds": 30,
    "MaxRestartDelaySeconds": 600
  },
  "Modules": {
    "Decoy": { "Enabled": true }
  },
  "Decoy": {
    "Intensity": "Balanced",
    "ScanRoots": [],
    "MaxFilesPerSecond": 8,
    "BytesReadPerFile": 65536,
    "MaxFileSizeBytes": 268435456,
    "WriteScanLog": true,
    "ScanLogPath": null
  }
}
